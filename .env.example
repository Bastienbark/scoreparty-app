# Config de l'app Web Firebase (console.firebase.google.com → ⚙️ Paramètres du projet → Vos applications → Web)
# Copier ce fichier en `.env`, remplir avec les vraies valeurs. Sans ça, la sauvegarde
# cloud reste désactivée (l'app fonctionne normalement en local uniquement).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
